# Autoridade (App 1)
PORT=3001
# Sem MONGODB_URI, a Autoridade sobe com Mongo em memoria e ja semeia a demo.
# MONGODB_URI=mongodb://127.0.0.1:27017/mandato_agentico

# Credencial do agente da demo (o segredo do bilhete assinado).
AGENT_ID=agent_marina
AGENT_SECRET=demo-agent-secret-marina

# Lojas (App 2)
AUTHORITY_URL=http://127.0.0.1:3001
STORE_A_URL=http://127.0.0.1:4001
STORE_B_URL=http://127.0.0.1:4002
STORE_FAKE_URL=http://127.0.0.1:4003

# LLM do agente (Fase 5) -- OpenAI.  A chave comeca com "sk-" e sai da pagina
# "API keys" do platform.openai.com.  NUNCA commite este arquivo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
