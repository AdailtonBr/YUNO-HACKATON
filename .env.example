# Autoridade (App 1)
PORT=3001
# Sem MONGODB_URI, a Autoridade sobe com Mongo em memoria e ja semeia a demo.
# Com ela, os dados persistem entre restarts (o que a demo quer).
# MONGODB_URI=mongodb+srv://USER:SENHA@cluster.mongodb.net/mandato_agentico
#
# `mongodb+srv://` depende de registro SRV no DNS, e algumas redes nao devolvem
# esse tipo de registro ("querySrv ENOTFOUND") mesmo com a string certa. Por isso
# o processo aponta para um DNS publico quando a URI e +srv. Deixe vazio para
# desligar em redes que exijam o resolver interno.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Credencial do agente da demo (o segredo do bilhete assinado).
AGENT_ID=agent_michael
AGENT_SECRET=demo-agent-secret-michael

# Lojas (App 2)
AUTHORITY_URL=http://127.0.0.1:3001
STORE_A_URL=http://127.0.0.1:4001
STORE_B_URL=http://127.0.0.1:4002
STORE_FAKE_URL=http://127.0.0.1:4003

# LLM do agente (Fase 5) -- OpenAI.  A chave sai da pagina "API keys" do
# platform.openai.com.  NUNCA commite este arquivo (.env esta no .gitignore).
#
# O modelo so RASCUNHA (conversa e propoe).  Ele nunca entra no caminho
# critico da transacao -- quem decide e o motor deterministico (invariante 9).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
